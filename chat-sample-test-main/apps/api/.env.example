# API configuration. Copy to apps/api/.env and fill in real values
# (apps/api/.env is gitignored).
#
# The API/worker run in Docker, where docker-compose overrides POSTGRES_HOST and
# REDIS_HOST to the service names. To run the API directly on the host instead,
# point them at 127.0.0.1 (as below).
POSTGRES_USER=chatsample
POSTGRES_PASSWORD=chatsample
POSTGRES_DB=chatsample
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Local dev runs over http, so the session cookie must not require Secure.
COOKIE_SECURE=False
FRONTEND_ORIGIN=http://localhost:3000

# Dev only: relax strict X.509 verification for the LLM HTTP clients when behind
# a TLS-intercepting corporate proxy (Python 3.13+ rejects such CAs by default).
# Keep False outside such networks.
LLM_RELAX_TLS_STRICT=False

# Chatbot / in-app agent (LLM via langchain-openai). Required for the chat.
OPENAI_API_KEY=sk-your-openai-key
